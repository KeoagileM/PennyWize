<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1A2035"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textColor="#4A9EFF"
                android:backgroundTint="#1A2035"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monthly Goals"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Goals Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2035"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Monthly Budget Goals"
                android:textColor="#4A9EFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month (YYYY-MM)"
                android:textColor="#8A9BB5"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etMonth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="2026-01"
                android:textColorHint="#8A9BB5"
                android:textColor="#FFFFFF"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimum Goal (R)"
                android:textColor="#8A9BB5"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etMinGoal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="0.00"
                android:textColorHint="#8A9BB5"
                android:textColor="#FFFFFF"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="8dp"
                android:inputType="numberDecimal"/>

            <SeekBar
                android:id="@+id/seekBarMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10000"
                android:progress="0"
                android:progressTint="#4AFF9E"
                android:thumbTint="#4AFF9E"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maximum Goal (R)"
                android:textColor="#8A9BB5"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etMaxGoal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="0.00"
                android:textColorHint="#8A9BB5"
                android:textColor="#FFFFFF"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="8dp"
                android:inputType="numberDecimal"/>

            <SeekBar
                android:id="@+id/seekBarMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10000"
                android:progress="0"
                android:progressTint="#FF4A4A"
                android:thumbTint="#FF4A4A"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnSaveGoal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SAVE GOALS"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4A9EFF"/>

        </LinearLayout>

        <!-- Current Goal Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2035"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Goals"
                android:textColor="#4A9EFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvCurrentGoals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No goals set yet"
                android:textColor="#8A9BB5"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>