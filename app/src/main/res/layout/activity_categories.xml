<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#0A0F1F">

    <!-- Header -->
    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">


        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:backgroundTint="#1F2937"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#60A5FA" />

        <!-- Logout Button (Pinned Right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:backgroundTint="#2E5BFF"
            android:text="Logout"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_logout"
            app:iconSize="18dp"
            app:iconTint="@android:color/white" />


        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnLogout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="📁 Categories"
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Add Category Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➕ Add New Category"
                    android:textColor="#60A5FA"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etCategoryName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Category Name"
                    android:textColorHint="#94A3B8"
                    android:textColor="#FFFFFF"
                    android:background="#1F2937"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:inputType="text"/>

                <Button
                    android:id="@+id/btnAddCategory"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ADD CATEGORY"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Your Categories Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Your Categories"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Categories List Container -->
            <LinearLayout
                android:id="@+id/containerCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Navigation (5 tabs) ─────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="#0E1528"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏠" android:textColor="#5A9BFF" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textColor="#5A9BFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navExpenses"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💸" android:textColor="#5A9BFF" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Expenses" android:textColor="#5A9BFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCategories"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="3dp"
            android:background="#DCD3EA">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📁" android:textColor="#1F2937" android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Categories" android:textColor="#1F2937" android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navGoals"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏆" android:textColor="#5A9BFF" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Goals" android:textColor="#5A9BFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAnalytics"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📈" android:textColor="#5A9BFF" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Analytics" android:textColor="#5A9BFF" android:textSize="10sp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>