<?xml version="1.0" encoding="utf-8"?>
<!--
    item_achievement.xml
    A single achievement badge card.
    Locked badges are shown dimmed so the user can see what's coming.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/achievement_card_bg"
    android:elevation="4dp">

    <!-- Badge icon circle -->
    <FrameLayout
        android:id="@+id/flIconCircle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/achievement_icon_circle"
        android:layout_marginEnd="14dp">

        <TextView
            android:id="@+id/tvAchievementIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🏆"
            android:textSize="26sp" />
    </FrameLayout>

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAchievementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievement Title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAchievementDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description of what was achieved"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Tier / lock badge (right side) -->
    <TextView
        android:id="@+id/tvTierBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="20sp"
        android:layout_marginStart="8dp" />

</LinearLayout>